# Copy to `.env` for local builds. Never commit real values.
# Only VITE_* vars are exposed to the browser bundle — do NOT put
# service accounts, private keys, or admin tokens here.

# Firebase Analytics (web client config — restrict API key by HTTP referrer in GCP)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: FormSubmit email or form id (overrides profile.contact.email)
# VITE_CONTACT_FORM_ENDPOINT=iamdeveloper031999@gmail.com

# Optional flags
# VITE_DISABLE_ANALYTICS=true
# VITE_ENABLE_GA_IN_DEV=true
# VITE_ENABLE_CONSOLE_ANALYTICS=true
