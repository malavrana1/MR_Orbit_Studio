  "packageManager": "pnpm@8.15.0",
  "dependencies": {
    "bootstrap": "^5.3.8",
    "firebase": "^11.10.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.8",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-icons": "^5.7.0",
    "react-typed": "^2.0.12"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "sync-locales": "node scripts/generateContentKeys.js && node scripts/syncLocalesFromEn.js",
    "verify-locales": "node scripts/verifyLocales.js",
    "fill-missing-translations": "node scripts/fillMissingTranslations.js",
    "prebuild": "node scripts/generateContentKeys.js && node scripts/syncLocalesFromEn.js",
    "deploy": "pnpm run build && firebase deploy --only hosting",
    "format": "prettier --write \"src/**/*.{js,jsx,json,css}\" \"public/**/*.{html,json}\" \"*.{json,md}\" \"index.html\""
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "google-translate-api-x": "^10.7.3",
    "prettier": "^3.9.6",
    "vite": "^6.3.5"
  }
