{
  "name": "mr-orbit-studio",
  "version": "0.1.0",
  "private": true,
  "homepage": "/",
  "copyright": "Copyright © 2024 MR Orbit Studio. All rights reserved.",
  "packageManager": "pnpm@8.15.0",
  "dependencies": {
    "bootstrap": "^5.3.8",
    "react": "^19.2.3",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.3",
    "react-icons": "^5.5.0",
    "react-scripts": "^5.0.1",
    "react-typed": "^2.0.12"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "deploy": "pnpm run build && firebase deploy --only hosting",
    "format": "prettier --write \"src/**/*.{js,jsx,json,css}\" \"public/**/*.{html,json}\" \"*.{json,md}\"",
    "prepare": "husky"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "firebase-tools": "^15.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.0"
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "prettier --write"
    ],
    "src/**/*.{json,css}": [
      "prettier --write"
    ],
    "public/**/*.{html,json}": [
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "nth-check@<2.0.1": ">=2.0.1",
      "postcss@<8.4.31": ">=8.4.31",
      "diff@<8.0.3": ">=8.0.3"
    }
  }
}
